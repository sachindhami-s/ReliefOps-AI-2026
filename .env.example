# =============================================================================
# ReliefOps AI — Production Environment Configuration
# Course: CSE476 — Agentic AI and Intelligent Automation
# =============================================================================
# Default mode is DETERMINISTIC (no external API keys required).
# All 5 agents, RAG, and optimization operate out-of-the-box in deterministic mode.

# Execution Engine Mode: "deterministic" (default) or "llm"
RELIEFOPS_EXECUTION_MODE=deterministic

# Database and Storage Configuration
DATABASE_PATH=data/reliefops.db
CHROMADB_PATH=data/chromadb
SOP_DIR=data/sops

# Logging and Telemetry
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
RELIEFOPS_LOG_LEVEL=INFO
# Optional path to write structured logs to disk (leave empty for stdout only)
RELIEFOPS_LOG_FILE=

# Humanitarian Distributive Justice Policy Parameters
# Gini Coefficient Threshold (Humanitarian standard <= 0.35)
GINI_THRESHOLD=0.35
# Minimum Guaranteed Survival Floor Ratio (30% baseline allocation)
SURVIVAL_FLOOR_RATIO=0.30

# Geospatial Routing Configuration (Phase 12)
# Supported modes: "HAVERSINE_FALLBACK" (default offline) or "ROAD_NETWORK" (OSRM/OpenStreetMap with automatic fallback)
ROUTING_MODE=HAVERSINE_FALLBACK
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=5.0

# Web Dashboard Server Configuration (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# =============================================================================
# Optional: External LLM Provider Credentials
# (Only required if RELIEFOPS_EXECUTION_MODE is set to "llm")
# =============================================================================
# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL_ID=gpt-4o

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
